local RS = game:GetService("ReplicatedStorage")
local folder = RS:FindFirstChild("JankfireWraps") or Instance.new("Folder")
folder.Name = "JankfireWraps"
local function id(n) return "rbxassetid://" .. n end
local built = 0
for wid, b in BOOK do
	local sa = folder:FindFirstChild(wid) or Instance.new("SurfaceAppearance")
	sa.Name = wid
	sa.AlphaMode = Enum.AlphaMode.Overlay
	sa.ColorMap = id(b.color)
	sa.NormalMap = if b.normal then id(b.normal) else ""
	sa.RoughnessMap = if b.rough then id(b.rough) else ""
	sa.MetalnessMap = if b.metal then id(b.metal) else ""
	sa.EmissiveMaskContent = if b.emit then Content.fromUri(id(b.emit)) else Content.none
	sa.EmissiveStrength = if b.emit then b.emissive else 0
	sa.EmissiveTint = Color3.fromHex(b.tint)
	sa:SetAttribute("Swatch", id(b.swatch or b.color)) -- the loadout's chip shows the colour map (or its own chip picture)
	-- one hero picture per gun (Black Hole): WeaponModels lays Decal (lit) and DecalGlow (unlit, it blooms) once, on the
	-- left face of the gun's biggest painted piece (docs/WRAP-TEXTURES.md, "One black hole")
	sa:SetAttribute("Decal", if b.decal then id(b.decal) else nil)
	sa:SetAttribute("DecalGlow", if b.hole then id(b.hole) else nil)
	sa:SetAttribute("DecalStyle", b.style) -- ("hole": Black Hole's spin, ripple and motes; "mark": still, its stars breathe)
	sa:SetAttribute("DecalAspect", b.aspect) -- (the picture's width over its height; 1 when unset)
	sa:SetAttribute("DecalStars", b.stars) -- ("x,y,r;..." in the glow picture's pixels: one label a star)
	sa:SetAttribute("Finish", if b.finish ~= "" then b.finish else nil) -- and this word (GLOWS / SHINY) in its corner
	-- the wrap as a palette (docs/WRAP-TEXTURES.md, "A wrap is a palette"): Second tints the picture down to a dark tone
	-- of itself for the other half of the gun, Dark is that tone as one colour (the chip's band), Accent goes on the
	-- gun's glow pieces
	sa:SetAttribute("Second", Color3.fromHex(b.second))
	sa:SetAttribute("Dark", Color3.fromHex(b.dark))
	sa:SetAttribute("Accent", Color3.fromHex(b.accent))
	sa.Parent = folder
	built += 1
end
for _, c in folder:GetChildren() do if not BOOK[c.Name] then c:Destroy() end end
folder.Parent = RS
return built
