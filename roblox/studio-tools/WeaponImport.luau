--!nocheck
-- edit-time tool: brings uploaded weapon models (Open Cloud Model assets made by tools/roblox/export_weapons.py) into
-- ReplicatedStorage.JankfireWeapons as w_<id> templates, with nothing done by hand. the exporter already turned the
-- model so the upload lands in the file's own frame (metres, -Z forward: tools/roblox/rbxglb.py holds what was
-- measured) and wrote each piece's look into its name, "<node>__<material>__<code>". this module
--   1. paints every piece from its code and takes the code off the name again (the game finds pieces by
--      "<node>__<material>": needle, vents, kat_blade, _wzA / _wzB / _wzN wrap zones),
--   2. keeps a piece's picture if its material had one (the part's Color is the picture's average: a fallback if the
--      picture doesn't load; a wrap takes the picture off and puts it back),
--   3. CHECKS the facing: the template's box must equal the bounds the exporter printed (lo / hi, file metres). a
--      model that arrived turned has its long end on the wrong side and is refused.
-- a PAINT CODE is "<kind><rrggbb>[aa][+]": p plastic · n neon · m dark metal · s shiny metal (Metal + a little
-- Reflectance) · g glass (+ 2 hex digits of alpha) · w wood · r rubber / grip; "+" keeps the piece's picture.
-- THE PAINT IS A SWITCH (tools/roblox/weapon_paint.py: "calm", the Roblox game's quiet finish, or "web", the web
-- game's): the name of a piece always carries its WEB look; spec.paint = { ["<node>__<material>"] = code } paints
-- over it. the picture a piece arrived with is remembered in its WebTex attribute, so either paint can be put back
-- on a template without loading the asset again:
--   W.paint({ smg = { ["mag_wzA__smg_teal"] = "p2fc8b8", ... } }, { name = "calm" })
-- (node tools/roblox/weapon_import_call.mjs prints both calls from export_report.json.)
-- THE PAINT BOOK: PolishBackup.WeaponPaint (generated by weapon_paint.py, pushed with tools/roblox/push.mjs) holds
-- every gun's asset id, bounds and both paints, so nothing is pasted:
--   W.use()          repaint every template with the book's default paint          W.use("web")  the web paint
--   W.load({ "smg" })   bring models in again from their assets (nil = all), painted with the default
-- usage (Edit, execute_luau):
--   local W = require(game.ServerStorage.PolishBackup.WeaponImport:Clone())
--   return W.run({ smg = { id = 123456, lo = Vector3.new(-0.0387, -0.222, -0.3705), hi = Vector3.new(0.0293, 0.068, 0.3219), paint = { ... } } })
-- options (second argument): into = a folder to put the templates in instead of JankfireWeapons (to compare before
-- replacing), flat = true to drop the pictures and keep only flat colours, name = the paint's name (kept on the
-- template as its Paint attribute).
local W = {}

local function paint(d, code)
	local kind, hex, aa, keep = string.match(code, "^(%a)(%x%x%x%x%x%x)(%x?%x?)(%+?)$")
	if not kind then return false end
	d.Color = Color3.fromHex(hex)
	d.Reflectance = 0
	d.Transparency = 0
	if kind == "n" then d.Material = Enum.Material.Neon
	elseif kind == "m" then d.Material = Enum.Material.Metal
	elseif kind == "s" then d.Material = Enum.Material.Metal; d.Reflectance = 0.1 -- (SmoothPlastic + more shine washed big silver pieces out to white under the hall's lamps)
	elseif kind == "g" then
		d.Material = Enum.Material.Glass
		local a = if aa ~= "" then tonumber(aa, 16) / 255 else 0.4
		d.Transparency = math.clamp(1 - a, 0.2, 0.75)
	elseif kind == "w" then d.Material = Enum.Material.Wood
	elseif kind == "r" then d.Material = Enum.Material.Plastic
	else d.Material = Enum.Material.SmoothPlastic end
	if d:IsA("MeshPart") then
		local web = d:GetAttribute("WebTex")
		if web == nil then web = d.TextureID; d:SetAttribute("WebTex", web) end
		d.TextureID = if keep == "+" then web else ""
	end
	return true
end
W.paintPiece = paint

-- repaint templates that are already in the place: list = { <weapon id> = { ["<piece name>"] = code } }
function W.paint(list, opts)
	opts = opts or {}
	local lib = opts.into or game.ReplicatedStorage.JankfireWeapons
	local out = {}
	for wid, codes in list do
		local m = lib:FindFirstChild("w_" .. wid)
		if not m then table.insert(out, "w_" .. wid .. ": NOT IN THE PLACE"); continue end
		if m:GetAttribute("Set") == "kit" then continue end -- (a kit model wears its own colours: the paint tables are for the web models)
		local done, miss, bad, pics = 0, {}, {}, 0
		local seen = {}
		for _, d in m:GetDescendants() do
			if not d:IsA("MeshPart") then continue end
			local code = codes[d.Name]
			seen[d.Name] = true
			if not code then table.insert(miss, d.Name)
			elseif paint(d, code) then done += 1 else table.insert(bad, d.Name .. "=" .. code) end
			if d.TextureID ~= "" then pics += 1 end
		end
		local extra = {}
		for name in codes do if not seen[name] then table.insert(extra, name) end end
		if opts.name then m:SetAttribute("Paint", opts.name) end
		table.insert(out, ("w_%s: %d pieces painted (%d keep a picture)%s%s%s"):format(wid, done, pics,
			if #miss > 0 then ", NOT IN THE TABLE: " .. table.concat(miss, " ") else "",
			if #bad > 0 then ", BAD CODES: " .. table.concat(bad, " ") else "",
			if #extra > 0 then ", in the table but not in the model: " .. table.concat(extra, " ") else ""))
	end
	table.sort(out)
	return table.concat(out, "\n")
end

-- the axis-aligned box of a set of parts (each part's own box, turned by its CFrame)
local function box(parts)
	local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, p in parts do
		local cf, h = p.CFrame, p.Size / 2
		for sx = -1, 1, 2 do for sy = -1, 1, 2 do for sz = -1, 1, 2 do
			local q = cf:PointToWorldSpace(Vector3.new(h.X * sx, h.Y * sy, h.Z * sz))
			lo = lo:Min(q); hi = hi:Max(q)
		end end end
	end
	return lo, hi
end
W.box = box

function W.run(list, opts)
	opts = opts or {}
	local IS = game:GetService("InsertService")
	local lib = opts.into or game.ReplicatedStorage.JankfireWeapons
	local out = {}
	for wid, spec in list do
		local name = "w_" .. wid
		local ok, container = pcall(function() return IS:LoadAsset(spec.id) end)
		if not ok or not container then table.insert(out, name .. ": LOAD FAILED " .. tostring(container)); continue end
		local m = Instance.new("Model")
		m.Name = name
		local parts, bad, pics = {}, 0, 0
		for _, d in container:GetDescendants() do
			if not d:IsA("MeshPart") then continue end
			local base, web = d.Name:match("^(.+)__(%a%x%x%x%x%x%x%x?%x?)$")
			if base then
				d.Name = base
				local code = spec.paint and spec.paint[base]
				if not (code and paint(d, code)) then paint(d, web .. (if d.TextureID ~= "" then "+" else "")) end
			else bad += 1 end
			if opts.flat then d.TextureID = "" end
			if d.TextureID ~= "" then pics += 1 end
			d.Anchored = true; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false; d.Massless = true
			d.CastShadow = false
			table.insert(parts, d)
		end
		for _, d in parts do d.Parent = m end
		container:Destroy()
		if #parts == 0 then table.insert(out, name .. ": HAD NO MESHES"); m:Destroy(); continue end
		local lo, hi = box(parts)
		local note = ""
		if spec.lo and spec.hi then
			local tol = 0.004 + (spec.hi - spec.lo).Magnitude * 0.01
			local off = math.max((lo - spec.lo).Magnitude, (hi - spec.hi).Magnitude)
			if off > tol then
				table.insert(out, ("%s: REFUSED, it did not land in the file's frame (box %s .. %s, the exporter said %s .. %s, off by %.4f). was it exported with the current export_weapons.py?"):format(name, tostring(lo), tostring(hi), tostring(spec.lo), tostring(spec.hi), off))
				m:Destroy()
				continue
			end
			note = (" facing ok (off %.4f)"):format(off)
		else
			note = " FACING NOT CHECKED (no lo / hi given)"
		end
		m.WorldPivot = CFrame.new((lo + hi) / 2)
		m:SetAttribute("AssetId", spec.id)
		m:SetAttribute("FileFrame", true) -- (its pieces sit where the file has them: nothing was turned in Studio)
		if opts.name then m:SetAttribute("Paint", opts.name) end
		local old = lib:FindFirstChild(name)
		if old then old:Destroy() end
		m.Parent = lib
		table.insert(out, ("%s: %d pieces (%d with a picture, %d with no look code)%s, box %.4f %.4f %.4f .. %.4f %.4f %.4f"):format(name, #parts, pics, bad, note, lo.X, lo.Y, lo.Z, hi.X, hi.Y, hi.Z))
		task.wait()
	end
	table.sort(out)
	return table.concat(out, "\n")
end

local function book()
	local m = game.ServerStorage.PolishBackup.WeaponPaint:Clone()
	local t = require(m)
	m:Destroy()
	return t
end

-- repaint the templates in the place from the paint book. name: "calm" / "web" (nil = the book's default);
-- only: a list of weapon ids (nil = every gun in the book)
function W.use(name, only, opts)
	local t = book()
	name = name or t.paint
	local list = {}
	for wid, g in t.guns do
		if g[name] and (not only or table.find(only, wid)) then list[wid] = g[name] end
	end
	opts = opts or {}
	opts.name = name
	local out = "paint: " .. name .. "\n" .. W.paint(list, opts)
	-- the parked web set (W.models) wears the same paint, so switching models never brings an old paint back
	local sets = game.ServerStorage.PolishBackup:FindFirstChild("WeaponSets")
	local web = sets and sets:FindFirstChild("web")
	if web and not opts.into then W.paint(list, { into = web, name = name }) end
	return out
end

-- bring models in again from their assets, painted from the book. only: a list of weapon ids (nil = all)
function W.load(only, name, opts)
	local t = book()
	name = name or t.paint
	local list = {}
	for wid, g in t.guns do
		if not only or table.find(only, wid) then list[wid] = { id = g.id, lo = g.lo, hi = g.hi, paint = g[name] } end
	end
	opts = opts or {}
	opts.name = name
	return "paint: " .. name .. "\n" .. W.run(list, opts)
end

-- ---------------------------------------------------------------------------------------------------------------
-- THE MODELS ARE A SWITCH: "kit" (the default) or "web".
--   web  the web game's models (many small pieces, their paint from the paint book above)
--   kit  the Roblox game's own models (tools/roblox/gun_models.py): a few big chamfered pieces in flat colours,
--        SmoothPlastic, no pictures. asked for by the owner on 2026-11-15 ("would it be easier to recreate them in
--        roblox?"). their book is PolishBackup.WeaponKit (generated by export_weapons.py --kit).
-- both sets are kept in ServerStorage.PolishBackup.WeaponSets.{web,kit} (the Shredder's Tool too, as "Shredder");
-- ReplicatedStorage.JankfireWeapons holds a copy of the set in use and says which in its Models attribute.
--   W.models()        put the kit models in (a weapon with no kit model yet keeps its web model)
--   W.models("web")   put the web models back
--   W.kit({ "ar" })   bring kit models in (again) from their assets into the kit set, painted and checked
-- a kit model's box is not the web model's, so every template carries its file bounds (FileLo / FileHi, metres);
-- WeaponModels.build reads them from the template before it looks at the weapon's row.
local function sets()
	local pb = game.ServerStorage.PolishBackup
	local f = pb:FindFirstChild("WeaponSets")
	if not f then f = Instance.new("Folder"); f.Name = "WeaponSets"; f.Parent = pb end
	for _, n in { "web", "kit" } do
		if not f:FindFirstChild(n) then local s = Instance.new("Folder"); s.Name = n; s.Parent = f end
	end
	return f
end
local function kitBook()
	local m = game.ServerStorage.PolishBackup.WeaponKit:Clone()
	local t = require(m)
	m:Destroy()
	return t
end
W.OLD_FILES = { -- the three oldest web models keep their bounds in WeaponModels.FILES; the same numbers, for FileLo / FileHi
	redline = { lo = Vector3.new(-0.0408, -0.2822, -0.47), hi = Vector3.new(0.0657, 0.0808, 0.5047) },
	marbles = { lo = Vector3.new(-0.0419, -0.136, -0.37), hi = Vector3.new(0.0407, 0.1677, 0.112) },
	katana = { lo = Vector3.new(-0.0374, -0.0394, -0.8357), hi = Vector3.new(0.0374, 0.0829, 0.1306) },
}

-- park the web templates that are in the place now as the "web" set (done once, by itself, the first time the
-- models are switched). force = true parks them again over the copies already there
function W.parkWeb(force)
	local S = sets()
	local t = book()
	local n = 0
	for _, m in game.ReplicatedStorage.JankfireWeapons:GetChildren() do
		if not m:IsA("Model") or m:GetAttribute("Set") == "kit" then continue end
		local old = S.web:FindFirstChild(m.Name)
		if old and not force then continue end
		if old then old:Destroy() end
		local c = m:Clone()
		local wid = string.match(m.Name, "^w_(.+)$")
		local g = wid and (W.OLD_FILES[wid] or t.guns[wid])
		if g then c:SetAttribute("FileLo", g.lo); c:SetAttribute("FileHi", g.hi) end
		c:SetAttribute("Set", "web")
		c.Parent = S.web
		n += 1
	end
	local tool = game.ReplicatedStorage.JankfireTools:FindFirstChild("Shredder")
	if tool and tool:GetAttribute("Set") ~= "kit" and (force or not S.web:FindFirstChild("Shredder")) then
		local old = S.web:FindFirstChild("Shredder")
		if old then old:Destroy() end
		local c = tool:Clone(); c:SetAttribute("Set", "web"); c.Parent = S.web
		n += 1
	end
	return ("parked %d web models in PolishBackup.WeaponSets.web"):format(n)
end

-- bring kit models in from their assets into the kit set. only: a list of weapon ids (nil = every gun in the book)
function W.kit(only)
	local S = sets()
	local t = kitBook()
	local list = {}
	for wid, g in t.guns do
		if not only or table.find(only, wid) then list[wid] = { id = g.id, lo = g.lo, hi = g.hi, paint = g.paint, uv = g.uv } end
	end
	local wantShredder = list.shredder ~= nil
	list.shredder = nil -- (a Tool, not a template: W.kitShredder)
	local out = W.run(list, { into = S.kit, name = "kit" })
	if wantShredder then out ..= "\n" .. W.kitShredder() end
	local bad = {}
	for wid, g in list do
		local m = S.kit:FindFirstChild("w_" .. wid)
		if not m then continue end
		m:SetAttribute("FileLo", g.lo); m:SetAttribute("FileHi", g.hi); m:SetAttribute("Set", "kit")
		-- unfolded at export (tools/roblox/gun_uvs.py): its pieces can wear a wrap's picture (WeaponModels.wrap)
		for _, d in m:GetDescendants() do if d:IsA("MeshPart") then d:SetAttribute("WrapUV", if g.uv then true else nil) end end
		-- the kit's finish, checked: flat colour, smooth plastic (or the one glowing / glass piece), no picture
		for _, d in m:GetDescendants() do
			if not d:IsA("MeshPart") then continue end
			local ok = d.TextureID == "" and not d:FindFirstChildOfClass("SurfaceAppearance")
				and (d.Material == Enum.Material.SmoothPlastic or d.Material == Enum.Material.Neon or d.Material == Enum.Material.Glass)
			if not ok then table.insert(bad, m.Name .. "." .. d.Name) end
		end
	end
	return out .. (if #bad > 0 then "\nNOT IN THE KIT FINISH: " .. table.concat(bad, " ") else "")
end

-- SKINS. A skin is a kit model of its own, "w_<id>@<skin>" (tools/roblox/gun_models.py SKINS): the base gun with its
-- slots recoloured and some nodes swapped, keeping the grip, handguard, muzzle, sight line and moving nodes. It is
-- loaded into WeaponSets.kit like any kit model (W.kit({ "ar@cardboard" })). W.skin puts it on as the live template:
--   W.skin("ar", "cardboard")   the Assault Rifle wears Carl's Cardboard (for everyone: a look test, not a pick)
--   W.skin("ar")                back to the plain kit model
-- A per-player pick (owned skins, the loadout's picker, the save) is not built: see roblox/docs/GUN-MODELS.md.
function W.skin(id, name)
	local S = sets()
	local lib = game.ReplicatedStorage.JankfireWeapons
	local src = S.kit:FindFirstChild("w_" .. id .. (if name then "@" .. name else ""))
	if not src then return ("skin: no %s in WeaponSets.kit (W.kit({ \"%s\" }) first)"):format("w_" .. id .. (if name then "@" .. name else ""), id .. (if name then "@" .. name else "")) end
	local old = lib:FindFirstChild("w_" .. id)
	if old then old:Destroy() end
	local c = src:Clone()
	c.Name = "w_" .. id
	c:SetAttribute("Skin", name)
	c.Parent = lib
	return ("skin: w_%s wears %s"):format(id, name or "the plain kit model")
end

-- THE SHREDDER'S kit model. It is a Tool, so it is not a template: the kit model is built in its own frame (metres,
-- the rotor's hub at the origin, the mouth at -z, up +y) and put on the web Tool's Handle in the gun frame that
-- ShredderClient and ShredderServer build from Handle.Muzzle, sh_hub and sh_bell2. Those keep their names and the
-- frame does not move, so the hold (Holds "shredder"), the swivel and the suction cone are unchanged. Everything
-- else the Tool carries (the Handle, Muzzle, SuckField and its Suction, the script, the Grip) is the web Tool's own.
local SHRED_MUZZLE = 0.333 -- the kit model's mouth, metres in front of the hub (tools/roblox/gun_models.py shredder)
local SHRED_NAMES = { ["hub_wzN__dark"] = "sh_hub", ["chute_wzB__frame"] = "sh_bell2" }
function W.kitShredder()
	local S = sets()
	local g = kitBook().guns.shredder
	if not g then return "shredder: not in the kit book" end
	local web = S.web:FindFirstChild("Shredder") or game.ReplicatedStorage.JankfireTools:FindFirstChild("Shredder")
	if not web or web:GetAttribute("Set") == "kit" then return "shredder: no web Tool to build on (W.parkWeb first)" end
	local h = web:FindFirstChild("Handle")
	local hub, chute = web:FindFirstChild("sh_hub", true), web:FindFirstChild("sh_bell2", true)
	local mz = h and h:FindFirstChild("Muzzle")
	if not (h and hub and chute and mz) then return "shredder: the web Tool lacks Handle / Muzzle / sh_hub / sh_bell2" end
	local hubH = h.CFrame:PointToObjectSpace(hub.Position)
	local axis = mz.Position - hubH
	local K = axis.Magnitude / SHRED_MUZZLE -- studs per metre (the web Tool's own scale, about 3)
	axis = axis.Unit
	local up = h.CFrame:PointToObjectSpace(chute.Position) - hubH
	up = (up - axis * axis:Dot(up)).Unit
	local G = CFrame.lookAt(Vector3.zero, axis, up) -- handle space: -Z = the mouth, +Y = up
	-- the kit pieces, loaded and checked like a template (into a scratch folder)
	local scratch = Instance.new("Folder")
	local res = W.run({ shredder = { id = g.id, lo = g.lo, hi = g.hi, paint = g.paint } }, { into = scratch, name = "kit" })
	local src = scratch:FindFirstChild("w_shredder")
	if not src then scratch:Destroy(); return "shredder: " .. res end
	local tool = web:Clone()
	for _, c in tool:GetChildren() do if c:IsA("Model") then c:Destroy() end end
	local hd = tool.Handle
	for _, c in hd:GetChildren() do if c:IsA("WeldConstraint") and (c.Part1 == nil or c.Part1.Parent == nil) then c:Destroy() end end
	local holder = Instance.new("Model")
	holder.Name = "w_shredder"
	local n = 0
	for _, d in src:GetChildren() do
		if not d:IsA("MeshPart") then continue end
		local wz = string.match(string.lower(d.Name), "_wz(%a+)")
		if wz then d:SetAttribute("WrapZone", wz) end
		d:SetAttribute("WrapUV", if g.uv then true else nil) -- (unfolded at export: it can wear a wrap's picture)
		d.Name = SHRED_NAMES[d.Name] or d.Name
		d.Size *= K
		d.CFrame = hd.CFrame * CFrame.new(hubH) * G * CFrame.new(d.Position * K)
		d.Anchored = false; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false; d.Massless = true
		d.Parent = holder
		local wc = Instance.new("WeldConstraint"); wc.Part0 = hd; wc.Part1 = d; wc.Parent = hd
		n += 1
	end
	holder.Parent = tool
	scratch:Destroy()
	for k in tool:GetAttributes() do tool:SetAttribute(k, nil) end
	tool:SetAttribute("Set", "kit")
	tool:SetAttribute("FileLo", g.lo); tool:SetAttribute("FileHi", g.hi)
	local old = S.kit:FindFirstChild("Shredder")
	if old then old:Destroy() end
	tool.Parent = S.kit
	return ("shredder: %d kit pieces on the web Tool's Handle (%.2f studs a metre), in WeaponSets.kit"):format(n, K)
end

-- which models the place wears. name: "kit" (nil = kit) or "web"; only: a list of weapon ids (nil = all)
function W.models(name, only)
	name = name or "kit"
	if name ~= "kit" and name ~= "web" then return "unknown set " .. tostring(name) .. " (kit / web)" end
	local S = sets()
	local out = {}
	if #S.web:GetChildren() == 0 then table.insert(out, W.parkWeb()) end
	local lib = game.ReplicatedStorage.JankfireWeapons
	local n = { kit = 0, web = 0 }
	local names = {}
	for _, m in S.web:GetChildren() do names[m.Name] = true end
	for _, m in S.kit:GetChildren() do if not string.find(m.Name, "@", 1, true) then names[m.Name] = true end end -- (skins: W.skin)
	for nm in names do
		if only and not table.find(only, (string.gsub(nm, "^w_", ""))) and not table.find(only, string.lower(nm)) then continue end
		local pick = (name == "kit" and S.kit:FindFirstChild(nm)) or S.web:FindFirstChild(nm)
		if not pick then continue end
		local home = if pick:IsA("Tool") then game.ReplicatedStorage.JankfireTools else lib
		local old = home:FindFirstChild(nm)
		if old then old:Destroy() end
		pick:Clone().Parent = home
		n[pick:GetAttribute("Set") or "web"] += 1
	end
	if not only then lib:SetAttribute("Models", name) end
	table.insert(out, ("models: %s (%d kit, %d web in the place now)"):format(name, n.kit, n.web))
	return table.concat(out, "\n")
end

-- THE SHREDDER is a Tool (ReplicatedStorage.JankfireTools.Shredder) that was imported by hand before the exporter
-- existed, so it is not in the paint book. its calm paint is this table, by part name: a dark steel hopper and
-- housing, steel teeth with their red tips, and the amber band as the one accent. the look it had before is
-- remembered on every part the first time (WebColor, WebMat, WebRefl, WebTex), so W.shredder("web") puts it back.
W.SHREDDER = {
	sh_bell3 = "m33363d", -- the hopper (was bright yellow)
	sh_bell4 = "p151515", -- its rim
	sh_trigger6 = "m26282d", sh_trigger7 = "m26282d", -- the cage
	sh_trigger5 = "m3a3d45", sh_bell2 = "m3a3d45", sh_grip3 = "m2e3138", -- housing, chute, motor block (were speckled grey)
	sh_hub = "m3a3d45", sh_hub2 = "s767b85", sh_hub3 = "m6a1c1c", -- the teeth: steel, dark red tips
	sh_trigger3 = "s767b85",
	sh_bell = "p1e2126", sh_grip = "r1a1a1a", sh_grip2 = "p1e2126",
	sh_trigger2 = "pb07a1c", -- the hazard band: flat amber (its striped picture was wavy and low-res up close)
}
function W.shredder(name)
	name = name or "calm"
	local tool = game.ReplicatedStorage.JankfireTools:FindFirstChild("Shredder")
	if tool and tool:GetAttribute("Set") == "kit" then -- (the kit Shredder wears its own colours: paint the parked web one)
		local sets_ = game.ServerStorage.PolishBackup:FindFirstChild("WeaponSets")
		tool = sets_ and sets_.web:FindFirstChild("Shredder")
	end
	if not tool then return "shredder: NOT IN THE PLACE" end
	local done, kept = 0, 0
	for _, d in tool:GetDescendants() do
		if not d:IsA("MeshPart") then continue end
		if d:GetAttribute("WebColor") == nil then
			d:SetAttribute("WebColor", d.Color); d:SetAttribute("WebMat", d.Material.Name)
			d:SetAttribute("WebRefl", d.Reflectance); d:SetAttribute("WebTex", d.TextureID)
		end
		local code = W.SHREDDER[d.Name]
		if name == "web" or not code then
			d.Color = d:GetAttribute("WebColor"); d.Reflectance = d:GetAttribute("WebRefl")
			d.Material = Enum.Material[d:GetAttribute("WebMat")]; d.TextureID = d:GetAttribute("WebTex")
			kept += 1
		elseif paint(d, code) then done += 1 end
	end
	tool:SetAttribute("Paint", name)
	return ("shredder: paint %s, %d pieces painted, %d as the web has them"):format(name, done, kept)
end

return W
