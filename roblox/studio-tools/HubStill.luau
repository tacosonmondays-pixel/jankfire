--!nonstrict
-- THE STILL (hub-originals, 20 Nov 2026; the owner: "one more thats completely new and unique with our design not
-- based on current infrastructure"). One shot, held still: a colossal round frozen mid-tumble as it burst out of a
-- struck stone monolith. The crater the blast scooped out is the centre (you spawn on its floor facing the bore); the
-- bore the round cut is the pad hall, its vault rifled, ending on the round's entry hole, a disc of sky; two glassy
-- shock rings frame its throat; twelve fragments hang where they flew; rooms are cut clean into the crater's raw rim
-- behind built stone frames: the GYM east, the ARMORY and training west, the LOUNGE (shop, bar, tables, VIP) south-west,
-- the ZOMBIES fissure south-east. Plan and rooms: vault Hubs/The Still plan.md.
-- The look is a chunky Blender kit modelled in the site's own frame (tools/roblox/still_models.py, one upload: HS.KIT;
-- HS.import(id) puts its models in ServerStorage.JankfireMeshes.HubStillKit); its collisions are unseen boxes from the
-- same numbers (HubStillData, generated by tools/roblox/still_data.py). The hub's functions are HubKit's features.
-- HS.build(K, parent, name, site, live) -> the folder; HS.walks(K) / HS.leaks() for K.check; HS.SHOTS for the photos.
local HS = {}
HS.ID, HS.FOLDER, HS.TITLE, HS.ORDER = "still", "Still", "THE STILL", 5
HS.SITE = CFrame.new(-1800, 240, -12600)
HS.KIT = 109710328693728 -- hub_still_kit_15 (the bays sized by mode for the classic pads, recessed rim blocks; kit 14 was 136903909478603)
HS.LIB = "HubStillKit"
local DECK = 2.4 -- (the rooms' floor: the top terrace)
local MON = Vector3.new(0, 5.6, -2) -- (the monument's plinth top: the lantern stands on it)
-- the well (kit 12, the same numbers as still_models.py): its flat south wall, centre, radius; the bays' plan angles (270 =
-- north), width, floor, inside height; the funnel's top and the oculus
local W_FW, W_CZ, W_R = -46, -66, 50
-- (kit 15, the owner's classic pads sized by mode, two side by side per bay) the bays' widths by mode and their angles,
-- equal piers between (still_models.py _bays)
local W_BAYS = { 179.547, 222.793, 267.476, 310.823, 356.593 }
local WB_WS = { 28, 34.4, 30.4, 32.2, 34.4 }
local WB_D, WB_FLOOR, WB_IN, WB_MOUTH = 15, 0.8, 18.5, 16
local W_TOP, W_OCULUS = 44, 9.5 -- (kit 13: the drum 26 high with its gallery, five courses of 3.6 over it)
local SS = game:GetService("ServerStorage")
local MAT = Enum.Material

-- ------------------------------------------------------------------------------------------------ the kit
-- piece names are "<model><n>__<kind>_<hex>"; kinds map to materials, colours to the training compound's subtle
-- textures (MaterialVariants TrSlate / TrConcrete / TrPlaster, already in MaterialService)
local KIND = { slate = MAT.Slate, concrete = MAT.Concrete, plastic = MAT.SmoothPlastic, neon = MAT.Neon, glass = MAT.Glass, metal = MAT.Metal }
local PLASTER = { cfc8ba = true, b9b2a5 = true, a39d92 = true, ada79c = true }
-- (judge round 4, blind against the ring: the bore one sepia; ribs and frames a warm off-white, walls and bay backs mid grey)
local RECOLOUR = { st_rifling = "e2dccf", st_bayframe = "ece4d4", st_holerim = "e2dccf", st_lining = "9f9a90", st_bayline = "8f8c86", st_bayback = "77746e", st_halo = "e6ddcc", st_cradle = "d6cfc1" } -- (judge round 11: frames, ring a warm off-white)
-- (judge round 4 and main: the floating round through a spiked burst read as a cartoon logo prop; the gym's rock slabs as
-- lumps. Left in the kit, not built)
local SKIP = { st_round = true, st_roundband = true, st_band = true, st_perch = true, st_shard = true, st_shock = true, st_tooth = true, st_frag = true, st_gymvault = true, st_gymrib = true }
function HS.import(id: number?): string
	local kit = id or HS.KIT
	local ok, c = pcall(function() return game:GetService("InsertService"):LoadAsset(kit) end)
	if not ok or not c then return "LOAD FAILED " .. tostring(c) end
	local lib = SS:FindFirstChild("JankfireMeshes") or Instance.new("Folder", SS)
	lib.Name = "JankfireMeshes"
	local old = lib:FindFirstChild(HS.LIB); if old then old:Destroy() end
	local f = Instance.new("Folder"); f.Name = HS.LIB; f:SetAttribute("AssetId", kit)
	local groups, n, bad = {}, 0, 0
	for _, d in c:GetDescendants() do
		if not d:IsA("MeshPart") then continue end
		local model, kind, h = string.match(d.Name, "^(.-)%d+__(%a+)_(%x%x%x%x%x%x)")
		if not model or not KIND[kind] then bad += 1; continue end
		d.Anchored = true; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false
		d.Color = Color3.fromHex(h); d.TextureID = ""
		d.Material = KIND[kind]
		d.CastShadow = kind ~= "neon" and kind ~= "glass"
		if RECOLOUR[model] then d.Color = Color3.fromHex(RECOLOUR[model]); if kind == "plastic" then d.Material = MAT.Plastic; d.MaterialVariant = "TrPlaster" end
		elseif kind == "slate" then d.MaterialVariant = "TrSlate"
		elseif kind == "concrete" then d.MaterialVariant = "TrConcrete"
		elseif kind == "plastic" and PLASTER[string.lower(h)] then d.Material = MAT.Plastic; d.MaterialVariant = "TrPlaster" end
		if kind == "glass" then d.Transparency = if model == "st_shock" then 0.62 else 0.45; d.Reflectance = 0.08 end
		if model == "st_round" then d.Color = Color3.fromHex("6b5543"); d.Reflectance = 0.04 end -- (a dark sculptural bronze, satin)
		if model == "st_roundband" then d.Color = Color3.fromHex("8c7a58") end
		groups[model] = groups[model] or {}
		table.insert(groups[model], d)
		n += 1
	end
	local names = {}
	for name, parts in groups do
		local m = Instance.new("Model"); m.Name = name
		for _, p in parts do p.Parent = m end
		m.WorldPivot = CFrame.identity
		m.Parent = f
		table.insert(names, name .. " " .. #parts)
	end
	c:Destroy()
	f.Parent = lib
	table.sort(names)
	return ("%d pieces in %d models%s: %s"):format(n, #names, if bad > 0 then (", %d unnamed"):format(bad) else "", table.concat(names, ", "))
end

-- ------------------------------------------------------------------------------------------------ the build
function HS.build(K, parent, name, site, live)
	local P = K.P
	local F0 = CFrame.new()
	local DR = require((SS:WaitForChild("PolishBackup"):WaitForChild("HubDress") :: ModuleScript):Clone())
	site = site or HS.SITE
	local f = K.begin(parent, name or HS.FOLDER, site, HS.ID, { Title = HS.TITLE, Order = HS.ORDER }, live)
	local shell, scen = f.Shell, f.Scenery
	local box = K.box

	-- the kit's meshes, pivoted to the site (they are modelled in its frame)
	local lib = SS:FindFirstChild("JankfireMeshes") and SS.JankfireMeshes:FindFirstChild(HS.LIB)
	local kit = Instance.new("Folder"); kit.Name = "Kit"; kit.Parent = f
	if lib then
		for _, m in lib:GetChildren() do
			if SKIP[m.Name] then continue end
			local c = m:Clone()
			c:PivotTo(site)
			if m.Name == "st_round" or m.Name == "st_roundband" then
				-- (judge round 5: nothing in the crater's middle; main: "serious and sculptural, not a toy bullet": the round stands
				-- upright on a stone plinth, a monument, its base on the plinth, 0.62 of its flying size)
				local B0, dir = Vector3.new(-3.5, 22.0, 0.0), Vector3.new(0.9613, 0.2756, 0)
				c.WorldPivot = site * CFrame.new(B0)
				c:ScaleTo(0.62)
				c:PivotTo(site * CFrame.new(MON.X, MON.Y, MON.Z) * CFrame.fromAxisAngle(Vector3.zAxis, math.acos(dir.Unit.Y)))
				for _, p in c:GetDescendants() do -- (judge round 6: dark brown read as a jokey pill: pale carved stone, one brass band)
					if p:IsA("BasePart") then
						if m.Name == "st_round" then p.Color = Color3.fromHex("d9d2c5"); p.Material = MAT.Plastic; p.MaterialVariant = "TrPlaster"; p.Reflectance = 0
						else p.Color = Color3.fromHex("b39257"); p.Material = MAT.Metal end
					end
				end
			end
			for _, p in c:GetDescendants() do if p:IsA("BasePart") then p:SetAttribute("Hub", HS.ID); K.S.count += 1 end end
			c.Parent = kit
		end
	else
		f:SetAttribute("KitMissing", true)
	end
	-- the unseen collision boxes (the same numbers the meshes were made from)
	local data = require((SS:WaitForChild("PolishBackup"):WaitForChild("HubStillData") :: ModuleScript):Clone())
	for _, b in data.coll do
		local p = Instance.new("Part")
		p.Name = "Col" .. b[1]; p.Anchored = true; p.CanCollide = true; p.CanQuery = true; p.CanTouch = false
		p.CastShadow = false; p.Transparency = 1; p.Material = MAT.SmoothPlastic
		p.Size = Vector3.new(b[5], b[6], b[7])
		p.CFrame = site * CFrame.new(b[2], b[3], b[4]) * CFrame.Angles(0, math.rad(b[8]), 0) * CFrame.Angles(math.rad(b[9]), 0, 0) * CFrame.Angles(0, 0, math.rad(b[10]))
		if b[1] == "CraterFloor" then p.Shape = Enum.PartType.Cylinder end
		if b[1] == "Perch" then p:Destroy(); continue end
		p:SetAttribute("Hub", HS.ID)
		p.Parent = shell
		K.S.count += 1
	end
	-- the sky: an unseen lid over the crater and an unseen ring above the rim's top, so nobody leaves over the rim
	local function unseen(nm, cf, size)
		local p = Instance.new("Part")
		p.Name = nm; p.Anchored = true; p.CanCollide = true; p.CanQuery = true; p.CanTouch = false; p.CastShadow = false
		p.Transparency = 1; p.Size = size; p.CFrame = site * cf; p:SetAttribute("Hub", HS.ID); p.Parent = shell
		return p
	end
	unseen("SkyLid", CFrame.new(0, 66, -10), Vector3.new(130, 4, 150))
	unseen("WellCap", CFrame.new(0, 20.0, -82), Vector3.new(104, 1, 74)) -- (the well's funnel is mesh only: nothing gets up into it)
	for i = 0, 35 do
		local a = math.rad(i * 10 + 5)
		local s = math.sin(a)
		local top = if s > 0.5 then 29 - 16 * (s - 0.5) / 0.5 else 29 + 11 * math.max(0, -s)
		if s < -0.55 then top = 52 end -- (the monolith's own height there)
		local r = 47
		unseen("SkyRing", CFrame.new(r * math.cos(a), (top + 66) / 2, r * s) * CFrame.Angles(0, -a, 0), Vector3.new(2, 66 - top, 2 * r * math.sin(math.rad(5)) + 0.6))
	end

	-- ============================================================== THE CRATER (spawn, the centre)
	for i = 0, 7 do K.marker(F0, "HubSpawns", "Spawn", -4.2 + (i % 4) * 2.8, 0.1, 20 + math.floor(i / 4) * 3, 0) end
	K.marker(F0, "HubArrive", "Arrive", 0, 0.1, 15, 0)
	K.travelTerminal(K.at(F0, 9, 23, 60))
	K.holoLoadout(K.at(F0, 17, 6, 70))
	K.bundles(K.at(F0, -19, 7, -70))
	-- the crater's middle: a low two-step stone dais with a lit ring under its cap, kept under eye height (judge round 9:
	-- the lantern column blocked the throat it framed; the well's sky disc is the hub's big object now)
	K.cyl(F0, "Shell", "MonPlinth", MON.X, 0, 1.3, MON.Z, 13, "b9b2a5", MAT.Plastic).MaterialVariant = "TrPlaster"
	K.cyl(F0, "Shell", "MonPlinth", MON.X, 1.3, 2.4, MON.Z, 9.4, "8f8a82", MAT.Slate).MaterialVariant = "TrSlate"
	K.cyl(F0, "Scenery", "MonCap", MON.X, 2.4, 2.9, MON.Z, 7.4, "cfc8ba", MAT.Plastic).MaterialVariant = "TrPlaster"
	K.light(K.cyl(F0, "Scenery", "MonRing", MON.X, 2.25, 2.45, MON.Z, 8.2, "e8c28a", MAT.Neon, { ghost = true, noshadow = true }), 12, 0.6, "ffd9a8")
	-- the ranked boards on the monolith's face either side of the throat, the spectate board on the south rim
	local function faceIn(a, r, y) local c, s = math.cos(math.rad(a)), math.sin(math.rad(a)); return K.facing(r * c, r * s, -c, -s, y) end
	K.boardSpot(faceIn(214, 34.2, 8.4), "duels", 9, 6)
	K.boardSpot(faceIn(326, 34.2, 8.4), "party", 9, 6)
	K.spectateSpot(faceIn(90, 34.0, 8.6), 16, 9)
	-- a jump pad onto the perch (the fragment lodged in the north-east rim, top y 18): a toy, nothing needs it
	-- (no perch, no jump pad: the lodged fragment read as a floating hopper)
	-- the crater's routes, plain from the spawn: a pale stone stair flight up the terraces to each room's frame
	local STEPS = { { 26, 28, 0.6 }, { 28, 30, 1.2 }, { 30, 32, 1.8 }, { 32, 34.5, 2.4 } }
	for _, rt in { { 0, 6.5 }, { 45, 3.6 }, { 135, 7 }, { 180, 5.5 } } do
		local a0, hw = rt[1], rt[2]
		for _, st in STEPS do
			local r0, r1, top = st[1], st[2], st[3]
			local half = math.deg(hw / r0)
			for k = -1, 1 do -- (three straight pieces round the curve)
				local a = math.rad(a0 + k * half * 2 / 3)
				local Fp = CFrame.lookAt(Vector3.zero, Vector3.new(math.cos(a), 0, math.sin(a)))
				local w = 2 * r1 * math.sin(math.rad(half / 3)) + 0.15
				box(Fp, "Scenery", "RouteTread", -w / 2, w / 2, top - 0.02, top + 0.05, -r1 + 0.05, -r0 - 0.35, "d6d0c4", MAT.Plastic).MaterialVariant = "TrPlaster"
			end
		end
	end
	-- lamps: warm low posts round the floor's edge where people stop, white panels under the overhang
	for _, a in { 35, 145 } do -- (judge round 10: half the bollards)
		local c, s = math.cos(math.rad(a)), math.sin(math.rad(a))
		local x, z = 24.6 * c, 24.6 * s
		-- a chunky pale stone bollard, a warm lit band let in under its cap
		box(F0, "Shell", "Bollard", x - 1.2, x + 1.2, 0, 3.0, z - 1.2, z + 1.2, "b9b4aa", MAT.Plastic)
		K.light(box(F0, "Scenery", "BollardGlow", x - 1.08, x + 1.08, 3.0, 3.5, z - 1.08, z + 1.08, P.warm, MAT.Neon, { ghost = true, noshadow = true }), 16, 0.8, P.warm)
		box(F0, "Scenery", "BollardCap", x - 1.35, x + 1.35, 3.5, 4.2, z - 1.35, z + 1.35, "a9a49a", MAT.Plastic)
	end

	-- ============================================================== THE WELL (pads)
	-- (judge round 9: any straight hall of pads reads as the RIVALS pad corridor) the throat opens into the well, a round
	-- room cut into the monolith under a corbelled funnel rising to a disc of sky; five deep bays fanned round its curve,
	-- one mode each (1V1 west .. 5V5 east), its two pads side by side (lifts left, east right), the boards inside the bay
	-- facing the well's middle; the mode set into each bay's lintel; a warm panel over each pad
	for k = 1, 5 do
		local md = K.MODES[k]
		local a = math.rad(W_BAYS[k])
		local w = WB_WS[k]
		local ux, uz = math.cos(a), math.sin(a)
		local lx, lz = uz, -ux -- (left, looking out into the bay)
		local Fb = CFrame.lookAt(Vector3.new(0, 0, W_CZ), Vector3.new(ux, 0, W_CZ + uz)) -- (its -Z out along the bay, +X to the right)
		local sz = K.CLASSIC_SIZE and K.CLASSIC_SIZE[md.id] or { 13.6, 11 }
		local off = if K.padClassic then sz[1] / 2 + 0.6 else 6.75
		for _, sd in { -1, 1 } do -- (sd -1: left, the lifts bank)
			local bank, id = if sd < 0 then "lifts" else "east", if sd < 0 then md.id else md.id .. "_e"
			if K.padClassic then -- (the classic pad at the bay's mouth, its count board on the bay's back wall behind it)
				local r0, rb = W_R + 1.0, W_R + WB_D - 0.6
				local F = K.facing(ux * r0 - sd * lx * off, W_CZ + uz * r0 - sd * lz * off, ux, uz, WB_FLOOR)
				local boardAt = K.facing(ux * rb - sd * lx * off, W_CZ + uz * rb - sd * lz * off, -ux, -uz, WB_FLOOR + 6.2 + 2.75)
				K.pad(F, md, bank, id, { boardAt = boardAt })
			else
				local r0 = W_R + 2.5
				K.pad(K.facing(ux * r0 - sd * lx * off, W_CZ + uz * r0 - sd * lz * off, ux, uz, WB_FLOOR), md, bank, id, { lampY = 13 })
			end
			K.panel(Fb, sd * off, WB_IN, -(W_R + 6.5), 5, 6, { bright = 0.55, range = 20, lightHex = "fff1df" })
		end
		local sx, sz2 = ux * (W_R - 3.42), W_CZ + uz * (W_R - 3.42)
		K.sign(K.facing(sx, sz2, -ux, -uz, 17.8), "Scenery", "BaySign", math.min(21, w - 4), 3.0, 0, 0, 0,
			{ { md.title .. "  ·  " .. md.kind, "f2f0ea", 0.8 } }, { pps = 40, plate = "4a4f57", thick = 0.15, bright = 1.2 })
		-- the bay's back wall lit from a cove along its top
		local cv = box(Fb, "Scenery", "BayCove", -w / 2 + 1, w / 2 - 1, WB_IN - 0.9, WB_IN - 0.5, -(W_R + WB_D - 0.6), -(W_R + WB_D - 1.0), "f0dcb8", MAT.Neon, { ghost = true, noshadow = true })
		K.light(cv, 18, 0.8, "ffe4c4", { kind = "SurfaceLight", face = Enum.NormalId.Bottom, angle = 120 })
		-- a cream spoke in the floor from the middle's dais to the bay's mouth
		local A, B = Vector3.new(ux * 11.4, 0.02, W_CZ + uz * 11.4), Vector3.new(ux * (W_R - 4), 0.02, W_CZ + uz * (W_R - 4))
		local sp = box(F0, "Scenery", "WellSpoke", -0.6, 0.6, 0, 0.05, -0.5, 0.5, "e2dccf", MAT.Plastic)
		sp.MaterialVariant = "TrPlaster"
		sp.Size = Vector3.new(1.2, 0.05, (B - A).Magnitude); sp.CFrame = site * CFrame.lookAt((A + B) / 2, B)
	end
	-- the well's middle (judge round 10: no centre hero; a tall column hid the middle bay): a still pool under the disc of
	-- sky, a broad stone basin a step up, its water dark and glassy; standing in it on a cradle the kit's chunky stone ring
	-- (st_halo), its opening framing the middle bay from the spawn's axis; a warm band under the basin's lip
	K.cyl(F0, "Shell", "WellDais", 0, 0, 0.8, W_CZ, 22, "b9b2a5", MAT.Plastic).MaterialVariant = "TrPlaster"
	K.cyl(F0, "Shell", "PoolWall", 0, 0.8, 3.0, W_CZ, 17.4, "d9d2c5", MAT.Plastic).MaterialVariant = "TrPlaster"
	K.cyl(F0, "Shell", "PoolLip", 0, 3.0, 3.4, W_CZ, 18.2, "cfc8ba", MAT.Plastic).MaterialVariant = "TrPlaster"
	K.cyl(F0, "Scenery", "PoolBed", 0, 3.0, 3.1, W_CZ, 15.8, "2f3540", MAT.Slate).MaterialVariant = "TrSlate"
	local water = K.cyl(F0, "Shell", "PoolWater", 0, 3.1, 3.25, W_CZ, 15.8, "3d4a58", MAT.Glass)
	water.Transparency = 0.2; water.Reflectance = 0.35
	K.light(K.cyl(F0, "Scenery", "PoolBand", 0, 2.7, 2.85, W_CZ, 17.6, "e8c28a", MAT.Neon, { ghost = true, noshadow = true }), 14, 0.45, "ffd9a8")
	-- (kit 15: the wider bays leave only their jambs between them: no lit recesses on the drum)
	local sky = box(F0, "Scenery", "SkyLight", -0.5, 0.5, W_TOP - 1, W_TOP - 0.8, W_CZ - 0.5, W_CZ + 0.5, P.pale, nil, { ghost = true, tr = 1 })
	sky.CFrame = site * CFrame.lookAt(Vector3.new(0, W_TOP - 1, W_CZ), Vector3.new(0, 0, W_CZ))
	K.light(sky, 48, 0.75, "e6edf5", { kind = "SpotLight", face = Enum.NormalId.Front, angle = 70 })
	for i = 0, 7 do
		local q = math.rad(202.5 + i * 22.5)
		if math.sin(q) > 0.3 then continue end
		local x, z = math.cos(q) * 30, W_CZ + math.sin(q) * 30
		local u = box(F0, "Scenery", "DrumWash", x - 0.5, x + 0.5, 17, 17.2, z - 0.5, z + 0.5, P.pale, nil, { ghost = true, tr = 1 })
		u.CFrame = site * CFrame.lookAt(Vector3.new(x, 17, z), Vector3.new(math.cos(q) * 46, 30, W_CZ + math.sin(q) * 46))
		K.light(u, 26, 0.7, "ffe4c4", { kind = "SpotLight", face = Enum.NormalId.Front, angle = 70 })
	end
	-- (no blades: the pad's own head carries its mode; the mouths are 14 high so it reads from the walkway)
	for _, sd in { -1, 1 } do -- (two cream inlays from the spawn either side of the monument up to the PLAY beam)
		box(F0, "Scenery", "SpawnInlay", math.min(sd * 8.25, sd * 9.75), math.max(sd * 8.25, sd * 9.75), 0, 0.05, -47, 18, "e2dccf", MAT.Plastic).MaterialVariant = "TrPlaster"
		local A, B = Vector3.new(sd * 9, 0.02, -47), Vector3.new(sd * 3.2, 0.02, W_CZ + 9.4)
		local p = box(F0, "Scenery", "SpawnInlay", -0.75, 0.75, 0, 0.05, -0.5, 0.5, "e2dccf", MAT.Plastic)
		p.MaterialVariant = "TrPlaster"; p.Size = Vector3.new(1.5, 0.05, (B - A).Magnitude + 1.2); p.CFrame = site * CFrame.lookAt((A + B) / 2, B)
	end
	-- the PLAY header: a chunky stone beam across the bore where the bays begin, its name toward the crater
	box(F0, "Shell", "PlayBeam", -20, 20, 15.6, 18.8, -37.6, -35.6, "cfc8ba", MAT.Plastic).MaterialVariant = "TrPlaster"
	box(F0, "Scenery", "PlayBeamCap", -20.4, 20.4, 18.8, 19.4, -37.9, -35.3, "b9b2a5", MAT.Plastic).MaterialVariant = "TrPlaster"
	K.sign(K.facing(0, -35.55, 0, 1), "Scenery", "PlaySign", 12, 2.4, 0, 17.2, 0, { { "PLAY", P.pale, 0.82 } }, { pps = 40, plate = "4a4f57" })
	K.light(box(F0, "Scenery", "ThroatFill", -0.5, 0.5, 9, 9.2, -31, -30, P.pale, nil, { ghost = true, tr = 1 }), 24, 0.55, "ffe9cf")
	-- the overhang's underside: a warm fill thrown up under it (it read near-black)
	for _, x in { -14, 14 } do
		local u = box(F0, "Scenery", "OverhangFill", x - 0.5, x + 0.5, 30, 30.2, -24, -23, P.pale, nil, { ghost = true, tr = 1 })
		u.CFrame = site * CFrame.lookAt(Vector3.new(x, 30, -23.5), Vector3.new(x * 0.6, 48, -14))
		K.light(u, 30, 0.7, "ffe2c0", { kind = "SpotLight", face = Enum.NormalId.Front, angle = 100 })
	end
	-- the bore's mouth framed by one thick chamfered stone ring proud of the crater's face (its crown ~14 deep), the name
	-- cut in its crown
	local function faceZ(x, y)
