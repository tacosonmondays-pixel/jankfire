	local DU = { { "stop", 56.5, -14, -90 }, { "via", 56.5, -27.4, 180 }, { "stop", 70, -27.4, 180 }, { "via", 85, -27.4, 180 }, { "stop", 85, -14, 90 } }
	K.npc(F0, "Dune", DU[1][2], DECK, DU[1][3], DU[1][4])
	for k, w in DU do K.npcPoint(F0, "Dune", k, w[1], "stand", w[2], DECK, w[3], w[4], { pause = if w[1] == "stop" then { 4, 8 } else nil }) end

	for _, d in f:GetDescendants() do
		if not d:IsA("BasePart") or d:IsA("MeshPart") then continue end
		if d.Name == "LiveBoardPanel" or d.Name == "SpectatePanel" then d.Color = Color3.fromHex("3c4148") end
		if d.Name == "LiveBoardFrame" or d.Name == "SpectateFrame" then -- (a pale 1-stud bezel round each board)
			d.Color = Color3.fromHex("d6d5d0")
			local bz = d:Clone(); bz.Name = "BoardBezel"; bz.Size = d.Size + Vector3.new(1.4, 1.4, -0.1); bz.CFrame = d.CFrame * CFrame.new(0, 0, 0.12); bz.Color = Color3.fromHex("cfc8ba"); bz.Parent = d.Parent
		end
		if d.Name == "TableRug" or d.Name == "TableRugEdge" then d:Destroy(); continue end -- (two flat white circles on an empty floor)
		if d.Name == "PlinthRing" or d.Name == "PlinthLens" then d.Transparency = 0.45 end
		if d.MaterialVariant == "" then
			if d.Material == MAT.Slate then d.MaterialVariant = "TrSlate" elseif d.Material == MAT.Concrete then d.MaterialVariant = "TrConcrete" end
		end
	end
	DR.tone(K, f, { leather = "8c8078" })
	-- its own light (HubLook.looks.still: dusk), over the whole site
	K.lookZone("still", -220, 220, -60, 140, -220, 220)
	return f
end

