Roster.wraps = {} :: { Wrap }
Roster.wrapById = {} :: { [string]: Wrap }
local function wrap(id: string, name: string, rarity: string, pal: { string }, pat: string, mat: string?, refl: number?, tr: number?, neon: { number }?)
	local p = {}
	for _, h in pal do table.insert(p, hex(h)) end
	local w: Wrap = { id = id, name = name, rarity = rarity, pal = p, pat = pat, mat = mat, refl = refl, tr = tr, neon = neon }
	table.insert(Roster.wraps, w); Roster.wrapById[id] = w
end
