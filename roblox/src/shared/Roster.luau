--!strict
-- the loadout screen's data: every weapon in the web game (shared/weapons.js: names, colours, blurbs, rough stats) and
-- every wrap (shared/cosmetics.js + public/js/wrappack.js), as Roblox looks: a palette, a pattern laid over the
-- weapon's parts, a material. generated by gen_roster.mjs; live = playable on roblox today, the rest are "coming soon"
local Roster = {}

export type Stat = { label: string, text: string, bar: number }
export type Entry = { id: string, slot: string, name: string, color: Color3, desc: string, live: boolean, gimmick: string, stats: { Stat } }
export type Wrap = { id: string, name: string, rarity: string, pal: { Color3 }, pat: string, mat: string?, refl: number?, tr: number?, neon: { number }? }

local function hex(h: string): Color3 return Color3.fromHex(h) end

-- the fourth slot, utility, is the web game's item (key G): Shared.Items has the numbers, the rows at the end of the
-- list below the loadout screen's words. (the item rows are kept by hand, not by gen_roster.mjs)
Roster.SLOTS = { "primary", "secondary", "melee", "utility" }
Roster.SLOT_NAMES = { primary = "PRIMARY", secondary = "SECONDARY", melee = "MELEE", utility = "UTILITY" }
Roster.RARITY = {
	free = { name = "Free", color = hex("bbbbbb") },
	common = { name = "Common", color = hex("7dff4f") },
	rare = { name = "Rare", color = hex("4fb4ff") },
	epic = { name = "Epic", color = hex("c46bff") },
	legendary = { name = "Legendary", color = hex("ffb31a") },
}
Roster.MODES = { "normal", "reverse", "full" }

Roster.list = {} :: { Entry }
Roster.byId = {} :: { [string]: Entry }
local function add(e: any) e.color = hex(e.color); table.insert(Roster.list, e); Roster.byId[e.id] = e end
